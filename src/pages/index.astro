---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_BASE, SocialLinks, WEBSITE_SCHEMA } from '../consts'
import { Icon } from 'astro-icon/components'
import BlogCard from '../components/BlogCard.astro'
import { getCollection, getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import heroImage from '../assets/hero-illustration.png'

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4)

const homeEntry = await getEntry('pages', 'home')
const home = homeEntry?.data.home
if (!home) throw new Error('Missing homepage content: pages/home')
---

<BaseLayout>
	<script type="application/ld+json" set:html={JSON.stringify(WEBSITE_SCHEMA)} />
	<main
		class="app-container flex flex-col md:flex-row gap-12 justify-center py-36 md:py-48 pt-44 md:pt-56 relative"
	>
		<div class="flex flex-col gap-12 flex-1">
			<p class="block text-3xl opacity-70 mt-9 mb-4">{home.welcome}</p>
			<h1 class="text-8xl font-bold leading-none">{home.brand}</h1>

			{
				home.intro.map((line, i) => (
					<p
						class:list={[
							'font-light leading-normal',
							i === home.intro.length - 1
								? 'text-xl max-w-xl'
								: 'text-2xl max-w-2xl',
						]}
					>
						{line}
					</p>
				))
			}
			<div class="flex flex-wrap gap-8">
				{
					SocialLinks.map((link) => (
						<a
							class="text-xl text-primary dark:text-primary-dark underline hover:underline underline-offset-4"
							href={link.url}
							target="_blank"
						>
							{link.name}
						</a>
					))
				}
			</div>
			<div class="md:hidden">
				<Image
					src={heroImage}
					alt="Illustration of Michal Minecki holding a coffee cup"
					class="w-full max-w-5xl mx-auto"
				/>
			</div>
		</div>
		<div class="hidden md:flex items-center justify-center md:w-1/3 lg:w-2/5">
			<Image
				src={heroImage}
				alt="Illustration of Michal Minecki holding a coffee cup"
				class="w-full"
			/>
		</div>
	</main>

	<!-- Recent Posts Section -->
	<section class="app-container">
		<h2 class="section-title">Recent Posts</h2>
		<div class="posts-grid-container">
			{posts.map((post) => <BlogCard post={post} />)}
		</div>
		<a class="btn-secondary" href={`${SITE_BASE}/blog`}
			>Read All
			<Icon size={20} name="mdi:arrow-right" />
		</a>
	</section>

	<!-- Recent Posts Section -->
	<section class="app-container py-42 grid lg:grid-cols-2 gap-28 lg:gap-10">
		<div class="space-y-6">
			<h2 class="section-title">{home.aboutTitle}</h2>
			<p class="text-lg max-w-xl pb-4">{home.aboutBody}</p>
			<a class="btn-secondary" href={`${SITE_BASE}/about`}
				>Go to About
				<Icon size={20} name="mdi:arrow-right" />
			</a>
		</div>
		<div class="space-y-6">
			<h2 class="section-title">{home.contactTitle}</h2>
			<p class="text-lg max-w-xl">{home.contactBody}</p>
			<div class="flex flex-wrap mt-auto space-x-4">
				<a
					class="btn-primary"
					href="mailto:contact@mirzu.com"
					download
					target="_blank"
					>Get in touch
					<Icon height={20} name="mdi:email" />
				</a>
				<a class="btn-primary" href={`${SITE_BASE}/resume`} target="_blank"
					>view Resume
					<Icon height={20} name="mdi:file-document-outline" />
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
