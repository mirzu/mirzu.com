---
import ProsePageLayout from '../layouts/ProsePageLayout.astro'
import { getEntry, render } from 'astro:content'
import { PERSON_SCHEMA, SITE_URL, ABOUT_DESCRIPTION, ABOUT_KNOWS_ABOUT } from '../consts'

const page = await getEntry('pages', 'about')
if (!page) throw new Error('Missing content entry: pages/about')
const { Content } = await render(page)

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	'@id': `${SITE_URL}/about/`,
	url: `${SITE_URL}/about/`,
	name: 'About Michal Minecki',
	mainEntity: {
		...PERSON_SCHEMA,
		description: ABOUT_DESCRIPTION,
		knowsAbout: ABOUT_KNOWS_ABOUT,
	},
}
---

<ProsePageLayout
	heading={page.data.title}
	title={page.data.seoTitle}
	description={page.data.description}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
	<Content />
</ProsePageLayout>
