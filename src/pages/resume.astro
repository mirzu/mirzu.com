---
import ProsePageLayout from '../layouts/ProsePageLayout.astro'
import { getEntry, render } from 'astro:content'

const page = await getEntry('pages', 'resume')
if (!page) throw new Error('Missing content entry: pages/resume')
const { Content } = await render(page)
---

<ProsePageLayout heading={page.data.title}>
	<Content />
</ProsePageLayout>
